@{
    ViewData["Title"] = "Thank you";
    bool landlord = ViewBag.Landlord == true;
}

<div class="text-center py-5">
    <div class="display-1">🎉</div>
    <h2 class="fw-bold">Thank you!</h2>
    @if (landlord)
    {
        <p class="text-muted">We received your request. A Dwellr team member will contact you soon.</p>
    }
    else
    {
        <p class="text-muted">You're on the list. We'll email you when listings open near you.</p>
    }
    <a asp-controller="Listing" asp-action="Index" class="btn btn-primary">Preview current listings</a>
</div>