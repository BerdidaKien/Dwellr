@model Dwellr.Models.ListingRequest
@{
    ViewData["Title"] = "List Your Property";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <h1 class="fw-bold">List your property on Dwellr</h1>
        <p class="text-muted">
            Tell us about your place. Our team will contact you, verify your
            details, and post the listing for you, usually within 48 hours.
            You don't need to learn any new software.
        </p>

        <div class="card shadow-sm p-4">
            <div asp-validation-summary="All" class="alert alert-danger"></div>
            <form asp-controller="Leads" asp-action="ListYourProperty" method="post">
                <div class="mb-3">
                    <label class="form-label">Your name</label>
                    <input asp-for="FullName" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Mobile number</label>
                    <input asp-for="Phone" class="form-control" placeholder="09xx xxx xxxx" />
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Property type</label>
                        <select asp-for="Type" class="form-select"
                                asp-items="Html.GetEnumSelectList<Dwellr.Models.PropertyType>()"></select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Monthly rent (₱)</label>
                        <input asp-for="ExpectedPrice" class="form-control" type="number" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Area / barangay</label>
                    <input asp-for="Area" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Anything else we should know?</label>
                    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100">
                    Request listing
                </button>
                <p class="small text-muted mt-3 mb-0">
                    We use your details only for this Dwellr pilot. See our
                    <a asp-controller="Home" asp-action="Privacy">privacy notice</a>.
                </p>
            </form>
        </div>
    </div>
</div>