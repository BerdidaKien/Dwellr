@model IEnumerable<Dwellr.Models.ListingRequest>
@{
    ViewData["Title"] = "Experiment Dashboard";
    var waitlist = (List<Dwellr.Models.WaitlistEntry>)ViewBag.Waitlist;
}

<h2 class="fw-bold mb-4">📊 Experiment Dashboard</h2>

<div class="row g-3 mb-4 text-center">
    <div class="col-md-3"><div class="card p-3"><h3>@waitlist.Count</h3><small>Waitlist signups</small></div></div>
    <div class="col-md-3"><div class="card p-3"><h3>@Model.Count()</h3><small>Landlord requests</small></div></div>
    <div class="col-md-3"><div class="card p-3"><h3>@Model.Count(r => r.Status == Dwellr.Models.LeadStatus.IdChecked || r.Status == Dwellr.Models.LeadStatus.Listed)</h3><small>Landlords verified</small></div></div>
    <div class="col-md-3"><div class="card p-3"><h3>@Model.Count(r => r.Status == Dwellr.Models.LeadStatus.Listed)</h3><small>Listings posted</small></div></div>
</div>

<h5 class="fw-bold">Signups by source</h5>
<ul>
    @foreach (var g in waitlist.GroupBy(w => w.Source ?? "direct").OrderByDescending(g => g.Count()))
    {
        <li>@g.Key: <strong>@g.Count()</strong></li>
    }
</ul>

<h5 class="fw-bold mt-4">Landlord requests (manual pipeline)</h5>
<table class="table table-bordered align-middle">
    <thead class="table-dark">
        <tr><th>Landlord</th><th>Property</th><th>Status</th><th>Your notes</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.FullName<br /><small>@r.Phone</small></td>
                <td>@r.Type, @r.Area<br /><small>₱@r.ExpectedPrice</small></td>
                <td colspan="3">
                    <form asp-action="UpdateStatus" method="post" class="d-flex gap-2">
                        <input type="hidden" name="id" value="@r.ListingRequestId" />
                        <select name="status" class="form-select form-select-sm w-auto"
                                asp-items="Html.GetEnumSelectList<Dwellr.Models.LeadStatus>()"></select>
                        <input name="adminNotes" value="@r.AdminNotes" class="form-control form-control-sm"
                               placeholder="What did you do manually? Any pain point?" />
                        <button class="btn btn-sm btn-primary">Save</button>
                    </form>
                    <small class="text-muted">Current: @r.Status</small>
                </td>
            </tr>
        }
    </tbody>
</table>