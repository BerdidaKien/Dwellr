@model Dwellr.Models.AppUser
@{
    ViewData["Title"] = "My Profile";
}

<div class="row">
    <div class="col-md-4">
        <div class="card shadow-sm p-4 text-center">
            <div class="display-1 mb-3">👤</div>
            <h4>@Model.FullName</h4>
            <p class="text-muted">@Model.Email</p>
            <span class="badge bg-@(Model.VerificationStatus == Dwellr.Models.VerificationStatus.IDApproved ? "success" :
                  Model.VerificationStatus == Dwellr.Models.VerificationStatus.Banned ? "danger" : "warning")">
                @(Model.VerificationStatus == Dwellr.Models.VerificationStatus.IDApproved
                    ? "Verified Landlord" : Model.VerificationStatus.ToString())
            </span>
            <hr />
            <p><strong>Role:</strong> @Model.ActiveRole</p>
            <p><strong>Member since:</strong> @Model.CreatedAt.ToString("MMM yyyy")</p>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card shadow-sm p-4">
            <h5>Account Status</h5>
            <hr />
            @if (Model.VerificationStatus == Dwellr.Models.VerificationStatus.IDApproved)
            {
                <div class="alert alert-success">
                    ✅ You are a verified landlord. You can post listings.
                    If you just got approved and don't see Post Listing,
                    log out and log back in.
                </div>
            }
            else if (Model.ActiveRole == Dwellr.Models.UserRole.Landlord ||
                     Model.ActiveRole == Dwellr.Models.UserRole.Both)
            {
                <div class="alert alert-info">
                    ⏳ Landlord verification is done personally by the
                    Dwellr team. We will contact you to verify your details.
                    <a asp-controller="Leads" asp-action="ListYourProperty">
                        Request a listing
                    </a>
                </div>
            }
            else
            {
                <div class="alert alert-success">
                    ✅ Your account is active. You can browse, save listings,
                    and message landlords.
                </div>
            }
        </div>
    </div>
</div>