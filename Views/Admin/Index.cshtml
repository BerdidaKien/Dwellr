@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2 class="mb-4">Admin Dashboard</h2>
<div class="row g-4">
    <div class="col-md-4">
        <a asp-controller="Leads" asp-action="Dashboard" class="text-decoration-none">
            <div class="card shadow-sm text-center p-4 border-warning">
                <h1>📊</h1>
                <h5>Experiments</h5>
                <small class="text-muted">Waitlist signups and landlord pipeline</small>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-controller="Admin" asp-action="Users" class="text-decoration-none">
            <div class="card shadow-sm text-center p-4">
                <h1>👥</h1>
                <h5>Manage Users</h5>
                <small class="text-muted">Approve landlords, ban users</small>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-controller="Admin" asp-action="Reports" class="text-decoration-none">
            <div class="card shadow-sm text-center p-4">
                <h1>🚨</h1>
                <h5>View Reports</h5>
                <small class="text-muted">Handle user reports</small>
            </div>
        </a>
    </div>
</div>