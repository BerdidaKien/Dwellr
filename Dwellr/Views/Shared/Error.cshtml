@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-5">
    <div class="display-1 text-danger"><i class="bi bi-exclamation-triangle"></i></div>
    <h1 class="h3 mt-3">Something went wrong</h1>
    <p class="text-muted">We couldn't complete your request. Please try again, or head back home.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Reference: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to home</a>
</div>