@model IEnumerable<SavedListing>
@{
    ViewData["Title"] = "Saved Listings";
    ViewData["Unsave"] = true; // makes _PropertyCard show a Remove button
}

<h1 class="h2 mb-4"><i class="bi bi-heart-fill me-1" aria-hidden="true"></i>Saved Listings</h1>

@if (Model.Any())
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (var s in Model) { <partial name="_PropertyCard" model="s.Property!" /> }
    </div>
}
else
{
    <div class="text-center py-5">
        <div class="display-1"><i class="bi bi-heart me-1" aria-hidden="true"></i></div>
        <h2 class="h5 text-muted mt-3">No saved listings yet.</h2>
        <p class="text-muted">Tap <i class="bi bi-heart-fill me-1" aria-hidden="true"></i>Save on any listing to keep it here.</p>
        <a asp-controller="Listing" asp-action="Index" class="btn btn-primary">Browse listings</a>
    </div>
}