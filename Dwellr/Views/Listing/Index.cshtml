@model IEnumerable<Property>
@{
    ViewData["Title"] = "Browse Listings";
}

<h1 class="h2 mb-4">Browse Listings</h1>

@if (Model.Any())
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (var p in Model) { <partial name="_PropertyCard" model="p" /> }
    </div>
}
else
{
    <div class="text-center py-5 text-muted">
        <div class="display-1"><i class="bi bi-house-door me-1" aria-hidden="true"></i></div>
        <p>No listings yet. Check back soon.</p>
    </div>
}