@model Property
@{
    ViewData["Title"] = Model.Title;
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isAuth = User.Identity?.IsAuthenticated == true;
    var photos = Model.Photos?.ToList();
    var canSeeAddress = ViewBag.CanSeeAddress is true;
    var hasMap = canSeeAddress && Model.Latitude.HasValue && Model.Longitude.HasValue;
}



<div class="row g-4">
    <div class="col-md-8">
        @if (photos?.Count > 0)
        {
            <div id="photoCarousel" class="carousel slide mb-4 rounded overflow-hidden shadow" data-bs-ride="carousel">
                <div class="carousel-inner">
                    @for (var i = 0; i < photos.Count; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="@photos[i].ImagePath" class="d-block w-100 carousel-img"
                                 alt="@Model.Title, photo @(i + 1) of @photos.Count" loading="@(i == 0 ? "eager" : "lazy")" />
                        </div>
                    }
                </div>
                @if (photos.Count > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#photoCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous photo</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#photoCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next photo</span>
                    </button>
                    <div class="carousel-indicators">
                        @for (var i = 0; i < photos.Count; i++)
                        {
                            <button type="button" data-bs-target="#photoCarousel" data-bs-slide-to="@i"
                                    class="@(i == 0 ? "active" : "")" aria-label="Photo @(i + 1)"></button>
                        }
                    </div>
                }
            </div>
        }

        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
            <div>
                <span class="badge bg-primary mb-2">@Model.Type</span>
                <h1 class="h2 fw-bold">@Model.Title</h1>
                <p class="text-muted"><i class="bi bi-geo-alt-fill me-1" aria-hidden="true"></i>@(canSeeAddress ? Model.Address + ", " : "")@Model.District, @Model.City</p>
            </div>
            <h2 class="h3 fw-bold text-success">₱@Model.Price.ToString("N0") <small class="text-muted fs-6">/month</small></h2>
        </div>

        <div class="row text-center bg-light rounded p-3 mb-4 g-3">
            <div class="col-6 col-sm"><div class="fw-bold fs-4">@Model.Bedrooms</div><small class="text-muted"><i class="bi bi-door-closed me-1" aria-hidden="true"></i>Bedrooms</small></div>
            <div class="col-6 col-sm"><div class="fw-bold fs-4">@Model.Bathrooms</div><small class="text-muted"><i class="bi bi-droplet me-1" aria-hidden="true"></i>Bathrooms</small></div>
            <div class="col-6 col-sm"><div class="fw-bold fs-4">@Model.AreaSqM</div><small class="text-muted"><i class="bi bi-bounding-box me-1" aria-hidden="true"></i>m²</small></div>
            <div class="col-6 col-sm"><div class="fw-bold fs-4">@Model.AvailableFrom.ToString("MMM dd")</div><small class="text-muted"><i class="bi bi-calendar-event me-1" aria-hidden="true"></i>Available</small></div>
        </div>

        <div class="mb-4">
            <h2 class="h5 fw-bold">About this place</h2>
            <p class="text-muted">@Model.Description</p>
        </div>

        <div class="mb-4">
            <h2 class="h5 fw-bold mb-3"><i class="bi bi-geo-alt-fill me-1" aria-hidden="true"></i>Location</h2>
            @if (hasMap)
            {
                <div id="map" class="rounded shadow map"></div>
            }
            else
            {
                <div class="bg-light rounded p-4 text-center text-muted">
                    <p><i class="bi bi-geo-alt-fill me-1" aria-hidden="true"></i>@Model.District, @Model.City</p>
                    <small>@(canSeeAddress ? "The landlord has not pinned this listing on the map." : "Exact location shown after you message the landlord.")</small>
                </div>
            }
        </div>

        @if (isAuth)
        {
            <div class="mb-4">
                <button class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#reportModal"><i class="bi bi-flag-fill me-1" aria-hidden="true"></i>Report this listing</button>
            </div>
        }
    </div>

    <div class="col-md-4">
        <div class="card shadow border-0 p-4 sticky-md-top sticky-card">
            <h2 class="h5 fw-bold mb-2">Posted by</h2>
            <div class="d-flex align-items-center mb-3">
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3 avatar" aria-hidden="true">
                    @Model.Landlord?.FullName.FirstOrDefault()
                </div>
                <div>
                    <div class="fw-bold">@Model.Landlord?.FullName</div>
                    <small class="text-success"><i class="bi bi-patch-check-fill me-1" aria-hidden="true"></i>Verified Landlord</small>
                </div>
            </div>
            <hr />

            @if (!isAuth)
            {
                <p class="text-muted small mb-3"><i class="bi bi-lock-fill me-1" aria-hidden="true"></i>Login to contact the landlord.</p>
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100">Login to Contact</a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary w-100 mt-2">Create Account</a>
            }
            else if (currentUserId != Model.LandlordId)
            {
                <form asp-controller="Listing" asp-action="Save" method="post" class="mb-2">
                    <input type="hidden" name="propertyId" value="@Model.PropertyId" />
                    <button type="submit" class="btn btn-outline-danger w-100"><i class="bi bi-heart-fill me-1" aria-hidden="true"></i>Save Listing</button>
                </form>
                <a asp-controller="Rental" asp-action="Apply" asp-route-propertyId="@Model.PropertyId"
                   class="btn btn-success w-100 mb-3"><i class="bi bi-house-door me-1" aria-hidden="true"></i>Rent This Property</a>

                <p class="text-muted small mb-3"><i class="bi bi-lock-fill me-1" aria-hidden="true"></i>Contact info is hidden. Use the message form below.</p>
                <form asp-controller="Message" asp-action="Send" method="post">
                    <input type="hidden" name="receiverId" value="@Model.LandlordId" />
                    <input type="hidden" name="propertyId" value="@Model.PropertyId" />
                    <label for="body" class="visually-hidden">Message to landlord</label>
                    <textarea id="body" name="body" class="form-control mb-3" rows="4" maxlength="2000" required
                              placeholder="Hi, I'm interested in this property. Is it still available?"></textarea>
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-chat-dots me-1" aria-hidden="true"></i>Send Message</button>
                </form>
            }
            else
            {
                <div class="alert alert-info small">This is your listing.</div>
                <form asp-controller="Listing" asp-action="MarkRented" asp-route-id="@Model.PropertyId" method="post">
                    <button type="submit" class="btn btn-warning w-100"><i class="bi bi-house-door me-1" aria-hidden="true"></i>Mark as Rented</button>
                </form>
            }
        </div>
    </div>
</div>

@if (isAuth)
{
    <div class="modal fade" id="reportModal" tabindex="-1" aria-labelledby="reportTitle" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="reportTitle"><i class="bi bi-flag-fill me-1" aria-hidden="true"></i>Report listing</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="Listing" asp-action="Report" method="post">
                    <div class="modal-body">
                        <input type="hidden" name="propertyId" value="@Model.PropertyId" />
                        <input type="hidden" name="reportedUserId" value="@Model.LandlordId" />
                        <label for="reason" class="form-label">Reason for reporting</label>
                        <select id="reason" name="reason" class="form-select">
                            <option>Fake listing</option>
                            <option>Scam/Fraud</option>
                            <option>Incorrect information</option>
                            <option>Inappropriate content</option>
                            <option>Already rented but still listed</option>
                            <option>Other</option>
                        </select>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Submit report</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Styles {
    @if (hasMap) { <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" /> }
}

@section Scripts {
    @if (hasMap)
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        var popup = $"{Model.Title} – {Model.District}, {Model.City}";
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script>
            var pos = [@Model.Latitude.Value.ToString(inv), @Model.Longitude.Value.ToString(inv)];
            var map = L.map('map').setView(pos, 15);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors'
            }).addTo(map);
            var el = document.createElement('b');
            el.textContent = @Json.Serialize(popup);
            L.marker(pos).addTo(map).bindPopup(el).openPopup();
        </script>
    }
}