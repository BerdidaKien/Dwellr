@{
    ViewData["Title"] = "Thank You";
    var landlord = ViewBag.Landlord is true;
}

<div class="text-center py-5">
    <div class="display-1 text-success"><i class="bi bi-check-circle-fill"></i></div>
    <h1 class="h2 fw-bold mt-3">@(landlord ? "Request received" : "You're on the list")</h1>
    <p class="text-muted mx-auto" style="max-width:32rem">
        @(landlord
            ? "Our team will contact you to verify your details and post the listing, usually within 48 hours."
            : "We'll let you know by email when early access opens.")
    </p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to home</a>
</div>