@model RentalApplication
@{
    ViewData["Title"] = "Payment Receipt";
    var rows = new (string Label, string? Value)[] {
        ("Receipt No.", $"#DWL-{Model.RentalApplicationId:D6}"),
        ("Property", Model.Property?.Title),
        ("Location", $"{Model.Property?.District}, {Model.Property?.City}"),
        ("Landlord", Model.Property?.Landlord?.FullName),
        ("Tenant", Model.Tenant?.FullName),
        ("Amount paid", "₱" + Model.DepositAmount.ToString("N2")),
        ("Payment date", Model.PaidAt?.ToString("MMMM dd, yyyy hh:mm tt")),
        ("Status", Model.Status.ToString()) };
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="card shadow-sm p-4 text-center">
            <div class="display-1 text-success"><i class="bi bi-check-circle-fill"></i></div>
            <h1 class="h2 fw-bold text-success mt-2">Payment successful</h1>
            <p class="text-muted">Your rental has been confirmed. Here is your receipt.</p>
            <hr />

            <div class="card bg-light border-0 p-4 text-start mb-4">
                <h2 class="h6 fw-bold mb-3"><i class="bi bi-receipt me-1"></i>Receipt details</h2>
                <dl class="row mb-0">
                    @foreach (var (label, value) in rows)
                    {
                        <dt class="col-sm-4 text-muted fw-normal">@label</dt>
                        <dd class="col-sm-8 fw-semibold">@value</dd>
                    }
                </dl>
            </div>

            <div class="d-flex gap-2 justify-content-center flex-wrap no-print">
                <a asp-controller="Rental" asp-action="MyRentals" class="btn btn-primary"><i class="bi bi-house-door me-1"></i>My rentals</a>
                <a asp-controller="Wallet" asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-wallet2 me-1"></i>My wallet</a>
                <button type="button" class="btn btn-outline-secondary" onclick="window.print()"><i class="bi bi-printer me-1"></i>Print</button>
            </div>
        </div>
    </div>
</div>