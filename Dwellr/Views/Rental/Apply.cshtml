@model Property
@{
    ViewData["Title"] = "Rent This Property";
    decimal balance = ViewBag.Balance;
    decimal deposit = ViewBag.Deposit;
    bool hasEnough = balance >= deposit;
    var depositText = deposit.ToString("N0");
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="card shadow-sm p-4">
            <h1 class="h2 fw-bold mb-1"><i class="bi bi-house-door me-2"></i>Rent this property</h1>
            <p class="text-muted mb-4">Review the details before confirming your payment.</p>

            <div class="card bg-light border-0 p-3 mb-4">
                <div class="d-flex justify-content-between gap-2">
                    <div>
                        <h2 class="h5 fw-bold mb-1">@Model.Title</h2>
                        <p class="text-muted small mb-0"><i class="bi bi-geo-alt-fill me-1"></i>@Model.District, @Model.City</p>
                        <p class="text-muted small mb-0">Posted by @Model.Landlord?.FullName</p>
                    </div>
                    <span class="badge bg-primary align-self-start">@Model.Type</span>
                </div>
            </div>

            <h2 class="h6 fw-bold mb-3">Payment breakdown</h2>
            <table class="table table-bordered mb-4">
                <tr><td>Security deposit (1 month)</td><td class="text-end fw-bold">₱@deposit.ToString("N2")</td></tr>
                <tr class="table-dark"><td><strong>Total due</strong></td><td class="text-end"><strong>₱@deposit.ToString("N2")</strong></td></tr>
            </table>

            <div class="alert alert-@(hasEnough ? "success" : "danger") mb-4">
                <div class="d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-wallet2 me-1"></i>Your wallet balance</span>
                    <strong>₱@balance.ToString("N2")</strong>
                </div>
                @if (!hasEnough)
                {
                    <hr />
                    <p class="mb-2 small">You need ₱@((deposit - balance).ToString("N2")) more to complete this payment.</p>
                    <a asp-controller="Wallet" asp-action="TopUp" class="btn btn-warning btn-sm">
                        <i class="bi bi-plus-circle me-1"></i>Top up wallet
                    </a>
                }
            </div>

            @if (hasEnough)
            {
                <form asp-controller="Rental" asp-action="ConfirmPayment" method="post">
                    <input type="hidden" name="propertyId" value="@Model.PropertyId" />
                    <div class="alert alert-info small mb-3">
                        <i class="bi bi-info-circle me-1"></i>By confirming, ₱@deposit.ToString("N2") will be deducted from your
                        wallet and sent to the landlord. The property will be marked as rented.
                    </div>
                    <button type="submit" class="btn btn-success w-100 btn-lg"
                            onclick="return confirm('Confirm payment of ₱@(depositText)?')">
                        <i class="bi bi-check-circle-fill me-1"></i>Confirm payment
                    </button>
                </form>
            }

            <a asp-controller="Listing" asp-action="Detail" asp-route-id="@Model.PropertyId"
               class="btn btn-outline-secondary w-100 mt-2">← Back to listing</a>
        </div>
    </div>
</div>