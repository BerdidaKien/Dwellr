@model IEnumerable<RentalApplication>
@{
    ViewData["Title"] = "My Rentals";
}

<h1 class="h2 fw-bold mb-4"><i class="bi bi-house-door me-2"></i>My Rentals</h1>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <div class="display-1"><i class="bi bi-house-door"></i></div>
        <h2 class="h5 mt-3">No rentals yet.</h2>
        <a asp-controller="Listing" asp-action="Index" class="btn btn-primary mt-2">Browse listings</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var r in Model)
        {
            var p = r.Property!;
            var cover = p.Photos?.FirstOrDefault(ph => ph.IsCover) ?? p.Photos?.FirstOrDefault();
            <div class="col-md-6">
                <div class="card shadow-sm border-0 h-100">
                    @if (cover != null)
                    {
                        <img src="@cover.ImagePath" class="card-img-top thumb" alt="@p.Title" loading="lazy" />
                    }
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="badge bg-primary">@p.Type</span>
                            <span class="badge bg-@(r.Status == ApplicationStatus.Paid ? "success" : "secondary")">@r.Status</span>
                        </div>
                        <h2 class="h5 fw-bold">@p.Title</h2>
                        <p class="text-muted small mb-1"><i class="bi bi-geo-alt-fill me-1"></i>@p.District, @p.City</p>
                        <p class="text-muted small"><i class="bi bi-person me-1"></i>Landlord: @p.Landlord?.FullName</p>
                        <hr />
                        <div class="d-flex justify-content-between">
                            <div>
                                <small class="text-muted">Deposit paid</small>
                                <p class="fw-bold text-success mb-0">₱@r.DepositAmount.ToString("N2")</p>
                            </div>
                            <div class="text-end">
                                <small class="text-muted">Rented on</small>
                                <p class="fw-bold mb-0">@r.PaidAt?.ToString("MMM dd, yyyy")</p>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-0 d-flex gap-2">
                        <a asp-controller="Rental" asp-action="Receipt" asp-route-applicationId="@r.RentalApplicationId"
                           class="btn btn-outline-primary flex-grow-1"><i class="bi bi-receipt me-1"></i>View receipt</a>
                        <a asp-controller="Message" asp-action="Conversation" asp-route-propertyId="@p.PropertyId"
                           asp-route-otherUserId="@p.LandlordId" class="btn btn-outline-secondary" aria-label="Message landlord">
                            <i class="bi bi-chat-dots"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}