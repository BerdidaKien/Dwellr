@model IEnumerable<Dwellr.Models.AppUser>
@{
    ViewData["Title"] = "Manage Users";
    string Badge(Dwellr.Models.VerificationStatus s) => s switch
    {
        Dwellr.Models.VerificationStatus.IDApproved => "success",
        Dwellr.Models.VerificationStatus.Banned => "danger",
        _ => "warning text-dark"
    };
}

<h1 class="h2 mb-4">Manage users</h1>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                var approved = user.VerificationStatus == Dwellr.Models.VerificationStatus.IDApproved;
                var banned = user.VerificationStatus == Dwellr.Models.VerificationStatus.Banned;
                <tr>
                    <td class="fw-semibold">@user.FullName</td>
                    <td class="text-break">@user.Email</td>
                    <td>@user.ActiveRole</td>
                    <td><span class="badge bg-@Badge(user.VerificationStatus)">@user.VerificationStatus</span></td>
                    <td>
                        <div class="d-flex flex-wrap gap-2">
                            @if (!approved && !banned)
                            {
                                <form asp-controller="Admin" asp-action="ApproveID" asp-route-userId="@user.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-success"
                                            onclick="return confirm('Approve this user as a landlord?')">
                                        <i class="bi bi-check-circle-fill me-1"></i>Approve as landlord
                                    </button>
                                </form>
                            }
                            @if (!banned)
                            {
                                <form asp-controller="Admin" asp-action="BanUser" asp-route-userId="@user.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Ban this user and hide their listings?')">
                                        <i class="bi bi-ban me-1"></i>Ban
                                    </button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>