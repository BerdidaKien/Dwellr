@model IEnumerable<Dwellr.Models.Report>
@{
    ViewData["Title"] = "Reports";
    string Badge(Dwellr.Models.ReportStatus s) => s switch
    {
        Dwellr.Models.ReportStatus.Actioned => "success",
        Dwellr.Models.ReportStatus.Reviewed => "warning text-dark",
        _ => "secondary"
    };
}

<h1 class="h2 mb-4">User reports</h1>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <div class="display-1"><i class="bi bi-flag"></i></div>
        <p class="mt-3">No reports yet.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr><th>Reporter</th><th>Reported user</th><th>Listing</th><th>Reason</th><th>Status</th><th>Date</th><th>Action</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.Reporter?.FullName</td>
                        <td>@r.ReportedUser?.FullName</td>
                        <td>@r.Property?.Title</td>
                        <td>@r.Reason</td>
                        <td><span class="badge bg-@Badge(r.Status)">@r.Status</span></td>
                        <td class="text-nowrap">@r.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td>
                            @if (r.Status == Dwellr.Models.ReportStatus.Pending)
                            {
                                <form asp-controller="Admin" asp-action="ActionReport" asp-route-reportId="@r.ReportId" method="post">
                                    <button type="submit" class="btn btn-sm btn-primary text-nowrap">
                                        <i class="bi bi-check2 me-1"></i>Mark actioned
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}