@{
    ViewData["Title"] = "Upload ID";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm p-4">
            <h1 class="h2 mb-3">Upload verification ID</h1>
            <p class="text-muted">Upload a valid government-issued ID to verify your identity as a landlord.</p>
            <form asp-controller="Account" asp-action="UploadID" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="idDocument" class="form-label">ID document</label>
                    <input id="idDocument" type="file" name="idDocument" class="form-control"
                           accept="image/*,.pdf" aria-describedby="idHelp" required />
                    <div id="idHelp" class="form-text">Accepted: JPG, PNG, PDF.</div>
                </div>
                <button type="submit" class="btn btn-primary w-100">Upload ID</button>
            </form>
        </div>
    </div>
</div>