@model Dwellr.Models.AppUser
@{
    ViewData["Title"] = "My Profile";
    var (badge, label) = Model.VerificationStatus switch
    {
        Dwellr.Models.VerificationStatus.IDApproved => ("success", "Verified landlord"),
        Dwellr.Models.VerificationStatus.Banned => ("danger", "Banned"),
        _ => ("warning text-dark", Model.VerificationStatus.ToString())
    };
}

<div class="row g-4">
    <div class="col-md-4">
        <div class="card shadow-sm p-4 text-center">
            <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mx-auto mb-3 avatar-lg" aria-hidden="true">
                @Model.FullName.FirstOrDefault()
            </div>
            <h1 class="h4">@Model.FullName</h1>
            <p class="text-muted text-break">@Model.Email</p>
            <div><span class="badge bg-@badge">@label</span></div>
            <hr />
            <p class="mb-1"><strong>Role:</strong> @Model.ActiveRole</p>
            <p class="mb-0"><strong>Member since:</strong> @Model.CreatedAt.ToString("MMM yyyy")</p>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card shadow-sm p-4">
            <h2 class="h5">Account status</h2>
            <hr />
            @if (Model.VerificationStatus == Dwellr.Models.VerificationStatus.IDApproved)
            {
                <div class="alert alert-success mb-0">
                    <i class="bi bi-check-circle-fill me-1"></i>You are a verified landlord. You can post listings.
                    If you just got approved and don't see Post Listing, log out and log back in.
                </div>
            }
            else if (Model.ActiveRole == Dwellr.Models.UserRole.Landlord || Model.ActiveRole == Dwellr.Models.UserRole.Both)
            {
                <div class="alert alert-info mb-0">
                    <i class="bi bi-hourglass-split me-1"></i>Landlord verification is done personally by the Dwellr team.
                    We will contact you to verify your details.
                    <a asp-controller="Leads" asp-action="ListYourProperty">Request a listing</a>
                </div>
            }
            else
            {
                <div class="alert alert-success mb-0">
                    <i class="bi bi-check-circle-fill me-1"></i>Your account is active. You can browse, save listings, and message landlords.
                </div>
            }
        </div>
    </div>
</div>