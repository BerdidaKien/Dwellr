@model IEnumerable<Message>
@{
    ViewData["Title"] = "Messages";
    var uid = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<h1 class="h2 mb-4">My Messages</h1>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <div class="display-1"><i class="bi bi-chat-dots"></i></div>
        <p class="mt-3">You have no messages yet. Message a landlord from any listing.</p>
        <a asp-controller="Listing" asp-action="Index" class="btn btn-primary">Browse listings</a>
    </div>
}
else
{
    <div class="list-group">
        @foreach (var m in Model)
        {
            var mine = m.SenderId == uid;
            var unread = !mine && !m.IsRead;
            <a asp-controller="Message" asp-action="Conversation" asp-route-propertyId="@m.PropertyId"
               asp-route-otherUserId="@(mine ? m.ReceiverId : m.SenderId)"
               class="list-group-item list-group-item-action @(unread ? "fw-bold" : "")">
                <div class="d-flex justify-content-between gap-2">
                    <span><i class="bi bi-house-door me-1"></i>@m.Property?.Title</span>
                    <small class="text-muted text-nowrap">@m.SentAt.ToString("MMM dd, yyyy")</small>
                </div>
                <div class="small text-muted text-truncate">@(mine ? "You" : m.Sender?.FullName): @m.Body</div>
                @if (unread) { <span class="badge bg-primary mt-1">New</span> }
            </a>
        }
    </div>
}